# ---------------------------------------------------------------------------
# Sequencing data — deposited to SRA/ENA under the BioProject, never in git.
# See DATA_LOCATIONS.md for where the canonical copies live.
# ---------------------------------------------------------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bam.bai
*.bai
*.cram
*.pod5
*.fast5

# ---------------------------------------------------------------------------
# Regenerable large intermediates. Recomputable from the deposited data with
# the scripts in this repo; excluded because they exceed GitHub's file limits.
# ---------------------------------------------------------------------------
*_pileup.bed
*_modonly.tsv

# BLAST / alignment indexes (rebuild with makeblastdb / STAR / hisat2-build)
*.nsq
*.nin
*.nhr
*.ndb
*.not
*.ntf
*.nto
star_index/
hisat2_index/

# antiSMASH output bundle (regenerate from the reference GenBank)
11_epigenome_integration/analysis/antismash_output/

# ---------------------------------------------------------------------------
# Working files that should never have been candidates for commit
# ---------------------------------------------------------------------------
.DS_Store
*~
*.bak
*.bak_*
.bak_*
temp/
tmp/
*_tmp/

# ---------------------------------------------------------------------------
# Downloaded reference genomes (re-fetchable from NCBI; see the fetch script)
# ---------------------------------------------------------------------------
*.fna
*.fna.gz
11_epigenome_integration/data/ncbi_genomes/
11_epigenome_integration/data/ncbi_genomes_all_species/

# ---------------------------------------------------------------------------
# Build / run detritus
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.log
.ipynb_checkpoints/
.Rhistory
.RData
